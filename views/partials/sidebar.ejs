<div class="md:col-span-5 lg:col-span-4">
  <div class="sticky top-[88px] rounded-[24px] border border-zinc-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 id="theme-list-label" class="font-sans text-base font-semibold">Browse themes</h2>
      <span id="progress" class="font-mono text-xs text-zinc-500"><%= counters.progress %></span>
    </div>
    <div class="relative">
      <label for="search" class="sr-only">Search themes</label>
      <input
        id="search"
        type="search"
        autocomplete="off"
        placeholder="Search themes..."
        aria-controls="theme-list"
        class="w-full rounded-full border border-zinc-200 bg-zinc-50 px-4 py-2.5 pl-9 font-mono text-xs outline-none focus:border-zinc-300 focus:bg-white"
      />
      <svg class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 21l-4.3-4.3M10 18a8 8 0 110-16 8 8 0 010 16z" />
      </svg>
    </div>
    <div id="pill-filters" class="no-scrollbar mt-3 flex gap-2 overflow-x-auto pb-1"><%- pillsHtml %></div>
    <p id="filter-meta" class="mt-2 font-mono text-xs text-zinc-400"><%= counters.meta %></p>
    <ul
      id="theme-list"
      role="listbox"
      tabindex="0"
      aria-labelledby="theme-list-label"
      <% if (active) { %>aria-activedescendant="theme-<%= active.id %>"<% } %>
      class="custom-scroll mt-3 max-h-[440px] space-y-2 overflow-y-auto pr-1.5 focus:outline-none"
    ><%- rowsHtml %></ul>
    <div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-4">
      <span class="font-mono text-xs text-zinc-400">↑↓ navigate • Enter opens demo</span>
      <div class="flex items-center gap-2">
        <button id="prev-btn" type="button" <%= counters.hasPrev ? '' : 'disabled' %> class="rounded-full border border-zinc-200 bg-white px-4 py-1.5 font-mono text-xs font-medium text-zinc-700 hover:bg-zinc-50 disabled:cursor-not-allowed disabled:opacity-40">Prev</button>
        <button id="next-btn" type="button" <%= counters.hasNext ? '' : 'disabled' %> class="rounded-full bg-zinc-900 px-4 py-1.5 font-mono text-xs font-medium text-white hover:bg-zinc-800 disabled:cursor-not-allowed disabled:opacity-40">Next</button>
      </div>
    </div>
  </div>
</div>
