<div class="md:col-span-7 lg:col-span-8">
  <div class="relative rounded-[28px] border border-zinc-200 bg-white p-3 shadow-[0_32px_80px_-20px_rgba(0,0,0,0.18)]">
    <div class="flex items-center justify-between rounded-[16px] bg-zinc-50 px-4 py-3">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
      </div>
      <div class="mx-4 flex w-full max-w-lg items-center gap-2 rounded-full bg-white px-3 py-1.5 shadow-sm ring-1 ring-zinc-200">
        <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        <span id="browser-url" class="truncate font-mono text-xs text-zinc-600"><%= active ? active.url : '' %></span>
        <span class="ml-auto font-mono text-xs text-zinc-300" aria-hidden="true">↻</span>
      </div>
      <span id="browser-count" class="hidden rounded-full bg-white px-2.5 py-1 font-mono text-xs text-zinc-500 ring-1 ring-zinc-200 md:inline"><%= counters.browser %></span>
    </div>

    <div class="relative mt-3 h-[78vh] min-h-[720px] overflow-hidden rounded-[16px] bg-zinc-100 ring-1 ring-zinc-200">
      <div class="h-full overflow-y-auto custom-scroll">
        <img
          id="preview-image"
          class="h-auto w-full object-contain object-top transition duration-[180ms]"
          src="<%= active ? (active.image || fallbackImage) : fallbackImage %>"
          data-fallback="<%= fallbackImage %>"
          data-transition-ms="180"
          alt="<%= active ? active.name : '' %>"
        />
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-zinc-900/50 via-zinc-900/10 to-transparent"></div>

      <div id="loading-bar" class="absolute left-0 top-0 h-[3px] w-0 bg-zinc-900 opacity-0 transition-all duration-[180ms]"></div>

      <div class="pointer-events-none absolute bottom-4 left-4 flex items-end gap-3">
        <div class="rounded-2xl bg-white/95 px-4 py-3 shadow-lg backdrop-blur">
          <p id="preview-label" class="font-sans text-sm font-semibold leading-none"><%= active ? counters.label : '' %></p>
          <p id="preview-cat" class="mt-1 font-mono text-xs text-zinc-500"><%= active ? active.category : '' %></p>
        </div>
        <span class="hidden rounded-full bg-zinc-900 px-3 py-1.5 font-mono text-xs font-medium text-white md:inline">Live Preview</span>
      </div>
    </div>
  </div>
</div>
