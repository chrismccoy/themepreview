<button
  type="button"
  data-cat="<%= name %>"
  aria-pressed="<%= isActive ? 'true' : 'false' %>"
  class="shrink-0 rounded-full border px-3 py-1.5 font-mono text-xs transition <%= isActive ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-zinc-200 bg-white text-zinc-600 hover:border-zinc-300 hover:bg-zinc-50' %>"
><%= name %> <span class="<%= isActive ? 'text-white/60' : 'text-zinc-400' %>">· <%= count %></span></button>
