# Required: the WordPress REST namespace this app reads from.
WP_API_BASE=https://example.com/wp-json/themeshowcase/v1

# Optional
PORT=3000
WP_TIMEOUT_MS=5000
# CACHE_TTL_MS=300000        # overrides the TTL the WordPress Cache-Control header reports
# CACHE_MIN_TTL_MS=60000     # floor for the resolved TTL, whatever WordPress reports
# CACHE_MAX_TTL_MS=900000    # ceiling for the resolved TTL
# FALLBACK_IMAGE=https://example.com/placeholder.png
# NAV_LINKS=Github|https://github.com/you, Directory|https://example.com/themes

# Extra origins screenshots may come from. Needed when WordPress serves media
# from a CDN or a separate media domain, since only the REST base and the
# fallback image origin are inferred.
# IMAGE_HOSTS=https://cdn.example.com, https://media.example.com

# Webfonts. Set FONT_STYLESHEET to an empty value to request nothing external;
# the content security policy drops the matching origins with it.
# FONT_STYLESHEET=
# FONT_FILE_HOST=https://fonts.gstatic.com
